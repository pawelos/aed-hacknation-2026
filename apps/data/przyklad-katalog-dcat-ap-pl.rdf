        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-21</dct:issued>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-21T17:11:50Z</dct:modified>
        <foaf:page rdf:resource="https://aed.hacknation-2026.pl/api/open-data/wzorcowy-zakres-danych-aed.xlsx" />
        <dcat:distribution>
          <dcat:Distribution rdf:about="https://aed.hacknation-2026.pl/api/open-data/aed.csv">
            <dcat:accessURL rdf:resource="https://aed.hacknation-2026.pl/api/open-data/aed.csv" />
            <dcat:downloadURL rdf:resource="https://aed.hacknation-2026.pl/api/open-data/aed.csv" />
            <dct:title xml:lang="pl">Defibrylatory AED – CSV</dct:title>
            <dct:title xml:lang="en">AED defibrillators – CSV</dct:title>
            <dct:description xml:lang="pl">Wszystkie rekordy w CSV (RFC 4180: UTF-8 bez BOM, przecinek, nagłówek z nazwami pól). Filtry: ?wojewodztwo=02, ?zrodlo=&lt;id&gt;.</dct:description>
            <dct:description xml:lang="en">All records as CSV (RFC 4180: UTF-8 without BOM, comma, header with field names). Filters: ?wojewodztwo=02, ?zrodlo=&lt;id&gt;.</dct:description>
            <dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV" />
            <dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv" />
            <dcat:license rdf:resource="https://creativecommons.org/licenses/by/4.0/" />
