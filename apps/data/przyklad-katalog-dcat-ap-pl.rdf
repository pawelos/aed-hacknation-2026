            <dct:description xml:lang="pl">Wszystkie rekordy jako GeoJSON (RFC 7946), punkty WGS 84, gotowe do map i systemów GIS.</dct:description>
            <dct:description xml:lang="en">All records as GeoJSON (RFC 7946), WGS 84 points, ready for maps and GIS.</dct:description>
            <dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/GEOJSON" />
