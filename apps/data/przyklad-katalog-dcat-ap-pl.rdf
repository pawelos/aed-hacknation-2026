            <dct:title xml:lang="pl">Defibrylatory AED – JSON</dct:title>
            <dct:title xml:lang="en">AED defibrillators – JSON</dct:title>
            <dct:description xml:lang="pl">Wszystkie rekordy w JSON z wersją schematu i datą wygenerowania.</dct:description>
