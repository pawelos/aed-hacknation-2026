# Secrets and settings of the AED prototype (deploy/stacks/app.yml).
# On the VPS: ~/hacknation-2026/aed.env (outside deploy/, which the pipeline replaces). deploy.sh creates it on the
# first "app up" with random POSTGRES_PASSWORD and JWT_SECRET; edit it only to add the optional values below.
# Never commit the real file (*.env is git-ignored).

# Public host of the prototype.
APP_HOST=aed.hacknation-2026.pl

# Database (the volume aed-postgres-data keeps the data across deployments).
POSTGRES_USER=aed
POSTGRES_DB=aed
POSTGRES_PASSWORD=

# Signing key of the panel access tokens (min. 32 characters).
JWT_SECRET=

# Optional: panel accounts admin@aed.local and the demo owners (wroclaw@, osp@aed.local). Empty = no accounts.
# At least 10 characters with an upper-case letter, a lower-case letter and a digit.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Quick fill of these accounts on the sign-in page (one click for the jury). The passwords above are then visible
# to anyone on that page: fine for the prototype with fictional data; false turns it off.
DEMO_LOGIN=true

# Optional memory limits.
# POSTGRES_MEMORY=256m
# API_MEMORY=384m
# WEB_MEMORY=256m
